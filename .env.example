# Replace all example secrets before starting a new installation.
LITELLM_MASTER_KEY=sk-change-this-master-key
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-this-ui-password
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-this-database-password
REDIS_PASSWORD=change-this-redis-password
# Optional full URL for database credentials that need percent encoding.
DATABASE_URL=

GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=4000
LITELLM_REQUEST_TIMEOUT_SECONDS=1320

# These services currently do not require authentication. Replace when enabled.
SPARK_15_API_KEY=not-required
SPARK_16_API_KEY=not-required

# Pin reviewed images for deployment. The local .env uses the tested digests.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

# Admission controller: use a unique secret shared only with LiteLLM.
SCHEDULER_INTERNAL_API_KEY=
MAX_ACTIVE_PER_PRINCIPAL=1
MAX_QUEUED_PER_PRINCIPAL=2
MAX_QUEUE_DEPTH=50
QUEUE_TIMEOUT_SECONDS=600
SCHEDULER_REQUEST_TIMEOUT_SECONDS=1260
LONG_QUEUE_PROMOTE_SECONDS=120
