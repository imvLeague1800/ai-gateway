# Fill these five secret fields (including SCHEDULER_INTERNAL_API_KEY below) with different secrets before starting.
# Generate random values with: openssl rand -hex 24
# The master key must start with sk- (append one of the generated values).
LITELLM_MASTER_KEY=
LITELLM_UI_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

LITELLM_UI_USERNAME=admin

# For access from your Windows computer, replace 127.0.0.1 with the Ubuntu
# server's private/LAN IP address. Allow access only from your company network.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=4000

SPARK_15_API_KEY=not-required
SPARK_16_API_KEY=not-required
LITELLM_REQUEST_TIMEOUT_SECONDS=1320

# Admission controller: use a unique secret shared only with LiteLLM.
SCHEDULER_INTERNAL_API_KEY=
MAX_ACTIVE_PER_PRINCIPAL=1
MAX_QUEUED_PER_PRINCIPAL=2
MAX_QUEUE_DEPTH=50
QUEUE_TIMEOUT_SECONDS=600
SCHEDULER_REQUEST_TIMEOUT_SECONDS=1260
LONG_QUEUE_PROMOTE_SECONDS=120
